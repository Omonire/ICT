{
  "name": "examflow",
  "version": "1.0.0",
  "private": true,
  "description": "ExamFlow — CBT examination scheduling and management platform",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c teal,blue \"npm run dev --workspace backend\" \"next dev -p 3000\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && next build",
    "start": "node server.js",
    "start:split": "concurrently -n api,web -c teal,blue \"npm run start --workspace backend\" \"next start -p 3000\"",
    "seed": "npm run seed --workspace backend",
    "typecheck": "npm run typecheck --workspace backend && tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
