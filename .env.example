# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────────
# For local dev, you can use a local PostgreSQL instance:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/examflow
#
# For production, use a hosted PostgreSQL provider:
#   - Vercel Postgres:  postgres://default:...@...pg.postgres.vercel-storage.com/...
#   - Neon:             postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/...
#   - Supabase:         postgres://postgres:...@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/examflow

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Backend
PORT=4000
NODE_ENV=development

# Seed demo data on first cold start (set to false in production after seeding)
SEED_ON_STARTUP=true

# Frontend proxy (set in Vercel frontend project)
# API_PROXY_TARGET=https://your-backend-api.vercel.app
