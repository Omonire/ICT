# ─────────────────────────────────────────────────────────────
# ExamFlow — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Backend (backend/.env)
PORT=4000
NODE_ENV=development

# Database — single connection URL
#   PostgreSQL : postgres://user:password@host:port/dbname
#   SQLite     : sqlite:./data/examflow.sqlite  (or sqlite:/absolute/path)
# If DATABASE_URL is unset, falls back to sqlite at ./data/examflow.sqlite
DATABASE_URL=sqlite:./data/examflow.sqlite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seed on startup when the database is empty
SEED_ON_STARTUP=true

# Frontend (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
