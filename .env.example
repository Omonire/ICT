# ─────────────────────────────────────────────────────────────
# ExamFlow — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Backend (backend/.env)
PORT=4000
NODE_ENV=development

# Database — PostgreSQL (production) or sqlite (zero-config demo)
#   postgres : requires DB_TYPE=postgres + DB_* below
#   sqlite   : self-contained file DB, no server required
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=examflow
# sqlite path is used when DB_TYPE=sqlite
DB_FILE=./data/examflow.sqlite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seed on startup when the database is empty
SEED_ON_STARTUP=true

# Frontend (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
