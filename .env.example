# ─────────────────────────────────────────────────────────────
# ExamFlow — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Backend (backend/.env)
PORT=4000
NODE_ENV=development

# Database — Turso Cloud (libSQL)
#   Turso URL   : libsql://your-db-name-your-org.turso.io
#   Local file  : backend/data/examflow.sqlite (or any absolute path)
# If DATABASE_URL is unset, a local file is used automatically.
DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seed on startup when the database is empty
SEED_ON_STARTUP=true

# Frontend (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
