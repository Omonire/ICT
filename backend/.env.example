# ExamFlow backend — copy to .env and fill in
PORT=4000
NODE_ENV=development

# Database — Turso Cloud (libSQL)
#   Turso URL   : libsql://your-db-name-your-org.turso.io
#   Local file  : backend/data/examflow.sqlite (or any absolute path)
DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

SEED_ON_STARTUP=true
