# ExamFlow backend — copy to .env and fill in
PORT=4000
NODE_ENV=development

# Database — single connection URL
#   PostgreSQL : postgres://user:password@host:port/dbname
#   SQLite     : sqlite:./data/examflow.sqlite  (or sqlite:/absolute/path)
DATABASE_URL=sqlite:./data/examflow.sqlite

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

SEED_ON_STARTUP=true
