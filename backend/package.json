{
  "name": "examflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ExamFlow REST API — Express + TypeORM + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/services/seeding.ts",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/data-source.ts migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/data-source.ts migration:generate"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.6",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
